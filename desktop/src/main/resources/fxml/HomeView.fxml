<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>
<!-- Background/surfaces on this screen use the extra "home-page-*" classes
     layered on top of the shared "home-scroll" / "home-root" base, so
     Attendance/Payments/Plans/Settings keep their existing plain-white
     look untouched (same pattern MembersView.fxml uses for "members-page-*"). -->
<ScrollPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.GymGate.UI.controller.HomeController"
            styleClass="home-scroll, home-page-scroll" fitToWidth="true" fitToHeight="true">

    <VBox styleClass="home-root, home-page-root" spacing="20">
        <padding><Insets top="20" right="28" bottom="24" left="28"/></padding>

        <!-- Top action buttons, populated by HomeController -->
        <HBox fx:id="actionButtonsContainer" spacing="12"/>

        <!-- Two-column main area -->
        <HBox spacing="20" VBox.vgrow="ALWAYS">

            <!-- Left column: camera feed + member card -->
            <VBox fx:id="leftColumn" spacing="20" HBox.hgrow="ALWAYS">
                <!-- CameraPanel injected here by controller -->
                <!-- MemberInfoCard injected here by controller -->
            </VBox>

            <!-- Right column: statistics only, now that notifications are removed -->
            <VBox prefWidth="420" minWidth="360" maxWidth="460" spacing="20">

                <VBox fx:id="statsPanel" styleClass="panel-card" spacing="16" VBox.vgrow="ALWAYS">
                    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <VBox>
                            <Label text="%Today's_Statistics" styleClass="panel-title"/>
                            <Label text="%Live_gym_activity" styleClass="panel-subtitle"/>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button fx:id="statsRefreshButton" styleClass="stats-refresh-button">
                            <graphic><FontIcon fx:id="statsRefreshIcon" iconLiteral="fas-sync-alt" styleClass="stats-refresh-icon"/></graphic>
                        </Button>
                        <Label text="%Real-time" styleClass="realtime-chip"/>
                    </HBox>

                    <GridPane fx:id="statsGrid" hgap="14" vgap="14" VBox.vgrow="ALWAYS"/>
                </VBox>

            </VBox>
        </HBox>
    </VBox>
</ScrollPane>
