<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<!--
  Generic Confirm/Cancel dialog. Still uses the existing .confirm-dialog-*
  and .primary-button / .secondary-button classes (now restyled to look
  less flat, see styles.css). The icon now sits in a soft circular badge
  (.confirm-dialog-icon-badge, new/additive) instead of floating bare.
-->
<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.GymGate.UI.controller.ConfirmDialogController"
           style="-fx-background-color: transparent;">

    <padding>
        <Insets top="36" right="36" bottom="36" left="36"/>
    </padding>

    <VBox styleClass="confirm-dialog-card" spacing="18" maxWidth="360" alignment="CENTER">

        <padding>
            <Insets top="32" right="30" bottom="26" left="30"/>
        </padding>

        <StackPane styleClass="confirm-dialog-icon-badge">
            <FontIcon fx:id="dialogIcon" iconLiteral="fas-question-circle" styleClass="confirm-dialog-icon"/>
        </StackPane>

        <Label fx:id="titleLabel" text="%Confirm_Action" styleClass="confirm-dialog-title"
               wrapText="true" textAlignment="CENTER"/>

        <Label fx:id="messageLabel" text="%Are_you_sure" styleClass="confirm-dialog-message"
               wrapText="true" textAlignment="CENTER"/>

        <HBox spacing="12" alignment="CENTER">
            <children>
                <Button fx:id="cancelButton" text="%Cancel" styleClass="secondary-button"/>
                <Button fx:id="confirmButton" text="%Confirm" styleClass="primary-button"/>
            </children>
        </HBox>

    </VBox>

</StackPane>
