<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<!-- Backgrounds/surfaces on this screen use the extra "payments-page-*"
     classes layered on top of the shared "home-scroll" / "home-root" base,
     same pattern as MembersView / PlansView / AttendanceView, so Home and
     Settings keep their existing plain-white look untouched. The table reuses
     the shared "attendance-table" base plus a scoped "payments-view-table"
     class so it picks up the same refined header/row treatment as the Members
     and Attendance tables without affecting them. -->
<ScrollPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.GymGate.UI.controller.PaymentController"
            styleClass="home-scroll, payments-page-scroll"
            fitToWidth="true"
            fitToHeight="true">

    <VBox styleClass="home-root, payments-page-root" spacing="12">
        <padding>
            <Insets top="20" right="28" bottom="24" left="28"/>
        </padding>

        <!-- Header card: title/subtitle and the List / Statistics switch on the
             left; the total revenue for the current scope, then the payment
             count, on the right. -->
        <HBox alignment="CENTER_LEFT" spacing="16" styleClass="payments-page-header">
            <fx:define>
                <ToggleGroup fx:id="viewToggle"/>
            </fx:define>
            <Region styleClass="payments-title-accent"/>
            <VBox spacing="2">
                <Label text="%Payments" styleClass="page-title"/>
                <Label text="%View_payment_history" styleClass="page-subtitle"/>
            </VBox>
            <HBox spacing="0" alignment="CENTER_LEFT" styleClass="filter-group">
                <ToggleButton fx:id="listTab" text="%List" selected="true"
                              toggleGroup="$viewToggle" styleClass="filter-option, filter-option-history"/>
                <ToggleButton fx:id="statsTab" text="%Statistics"
                              toggleGroup="$viewToggle" styleClass="filter-option, filter-option-history"/>
            </HBox>
            <Region HBox.hgrow="ALWAYS"/>
            <VBox alignment="CENTER_RIGHT" spacing="1" styleClass="payments-revenue-block">
                <Label text="%Revenue" styleClass="payments-revenue-caption"/>
                <Label fx:id="revenueLabel" styleClass="payments-revenue-value"/>
            </VBox>
            <Region styleClass="payments-header-divider"/>
            <Label fx:id="paymentCountLabel" styleClass="member-count-badge"/>
        </HBox>

        <!-- Selector bar: the stats granularity (only in Statistics view), then
             the year / month / day pickers, then Confirm. -->
        <HBox alignment="CENTER_LEFT" spacing="10" styleClass="payments-date-bar">
            <fx:define>
                <ToggleGroup fx:id="granularityToggle"/>
            </fx:define>
            <FontIcon iconLiteral="fas-calendar-alt" styleClass="payments-date-hint-icon"/>

            <HBox fx:id="granularityBar" spacing="0" alignment="CENTER_LEFT"
                  styleClass="filter-group" visible="false" managed="false">
                <ToggleButton fx:id="monthTab" text="%Month" selected="true"
                              toggleGroup="$granularityToggle" styleClass="filter-option, filter-option-history"/>
                <ToggleButton fx:id="yearTab" text="%Year"
                              toggleGroup="$granularityToggle" styleClass="filter-option, filter-option-history"/>
                <ToggleButton fx:id="allTab" text="%All_time"
                              toggleGroup="$granularityToggle" styleClass="filter-option, filter-option-history"/>
            </HBox>

            <ComboBox fx:id="yearCombo" styleClass="attendance-date-combo" prefWidth="96"/>
            <ComboBox fx:id="monthCombo" styleClass="attendance-date-combo" prefWidth="140"/>
            <ComboBox fx:id="dayCombo" styleClass="attendance-date-combo" prefWidth="78"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Button fx:id="confirmButton"
                    styleClass="pill-action-button, pill-action-primary">
                <graphic>
                    <HBox spacing="8" alignment="CENTER">
                        <FontIcon iconLiteral="fas-check"
                                  styleClass="pill-icon-primary"/>
                        <Label text="%Confirm"
                               styleClass="pill-label-primary"/>
                    </HBox>
                </graphic>
            </Button>
        </HBox>

        <!-- Payment list, populated by PaymentController on open and on every
             Confirm. -->
        <StackPane fx:id="listPane" styleClass="payments-table-frame" VBox.vgrow="ALWAYS">
            <TableView fx:id="paymentsTable"
                       styleClass="attendance-table, payments-view-table"
                       prefHeight="640">

                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>

                <columns>
                    <TableColumn fx:id="paymentColumn" text="%Member" prefWidth="300" minWidth="230"
                                 sortable="false" styleClass="payments-member-col"/>
                    <TableColumn fx:id="planColumn" text="%Plan" prefWidth="170" minWidth="130"
                                 sortable="false"/>
                    <TableColumn fx:id="dateColumn" text="%Date" prefWidth="150" minWidth="120"
                                 sortable="false"/>
                    <TableColumn fx:id="whenColumn" text="%Time" prefWidth="100" minWidth="85"
                                 sortable="false"/>
                    <TableColumn fx:id="amountColumn" text="%Amount" prefWidth="150" minWidth="120"
                                 sortable="false"/>
                </columns>

            </TableView>
        </StackPane>

        <!-- Revenue statistics: a calendar heat-map (Month) or a bar chart
             (Year / All time), built by PaymentController into statsSlot. -->
        <VBox fx:id="statsPane" styleClass="payments-table-frame, payments-stats-pane" spacing="0"
              VBox.vgrow="ALWAYS" visible="false" managed="false">
            <HBox alignment="CENTER_LEFT" spacing="10" styleClass="payments-stats-head">
                <Label fx:id="statsTitleLabel" styleClass="payments-stats-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="statsHintLabel" styleClass="payments-stats-hint"/>
            </HBox>
            <StackPane fx:id="statsSlot" VBox.vgrow="ALWAYS"/>
        </VBox>

    </VBox>

</ScrollPane>
