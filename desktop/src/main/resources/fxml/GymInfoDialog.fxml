<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.GymGate.UI.controller.GymInfoDialogController"
      styleClass="register-dialog-card"
      prefWidth="360" maxWidth="360" spacing="4">

    <padding><Insets top="28" right="28" bottom="24" left="28"/></padding>

    <!-- Icon badge + close button, same header pattern as every other dialog -->
    <HBox alignment="CENTER_LEFT">
        <StackPane styleClass="icon-tile-blue-soft" prefWidth="44" prefHeight="44"
                   minWidth="44" minHeight="44" maxWidth="44" maxHeight="44">
            <FontIcon iconLiteral="fas-building" styleClass="icon-tile-glyph" iconSize="18"/>
        </StackPane>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="closeButton" styleClass="dialog-close-btn">
            <graphic><FontIcon iconLiteral="fas-times" styleClass="dialog-close-icon"/></graphic>
        </Button>
    </HBox>

    <Label text="%Gym_Info" styleClass="dialog-title">
        <VBox.margin><Insets top="16"/></VBox.margin>
    </Label>

    <Label text="%Update_your_gyms_display_name_and_logo"
           styleClass="dialog-subtitle" wrapText="true">
        <VBox.margin><Insets top="6" bottom="20"/></VBox.margin>
    </Label>

    <!-- Logo preview + change button -->
    <VBox alignment="CENTER" spacing="12">
        <VBox.margin><Insets bottom="20"/></VBox.margin>

        <StackPane fx:id="logoFrame" styleClass="gym-logo-frame"
                   prefWidth="96" prefHeight="96" minWidth="96" minHeight="96" maxWidth="96" maxHeight="96">
            <FontIcon fx:id="logoPlaceholderIcon" iconLiteral="fas-dumbbell" styleClass="icon-tile-glyph" iconSize="30"/>
            <ImageView fx:id="logoImageView" fitWidth="76" fitHeight="76" preserveRatio="true" visible="false" managed="false"/>
        </StackPane>

        <Button fx:id="changeLogoButton" styleClass="pill-action-button" maxWidth="Infinity">
            <graphic>
                <HBox spacing="8" alignment="CENTER">
                    <FontIcon iconLiteral="fas-image" styleClass="pill-icon"/>
                    <Label text="%Change_Logo" styleClass="pill-label"/>
                </HBox>
            </graphic>
        </Button>
    </VBox>

    <!-- Gym name field -->
    <Label text="%Gym_Name" styleClass="dialog-field-label"/>
    <HBox styleClass="dialog-field" alignment="CENTER_LEFT" spacing="10">
        <VBox.margin><Insets top="6" bottom="24"/></VBox.margin>
        <FontIcon iconLiteral="fas-building" styleClass="info-chip-icon"/>
        <TextField fx:id="gymNameField" promptText="Iron Peak Gym" styleClass="dialog-field-input" HBox.hgrow="ALWAYS"/>
    </HBox>

    <Button fx:id="saveButton" styleClass="pill-action-button, pill-action-primary" maxWidth="Infinity">
        <graphic>
            <HBox spacing="10" alignment="CENTER">
                <FontIcon iconLiteral="fas-check-circle" styleClass="pill-icon-primary"/>
                <Label text="%Save_Changes" styleClass="pill-label-primary"/>
            </HBox>
        </graphic>
    </Button>

    <Button fx:id="cancelButton" styleClass="dialog-cancel-button" maxWidth="Infinity">
        <graphic>
            <HBox spacing="10" alignment="CENTER">
                <FontIcon iconLiteral="fas-arrow-left" styleClass="dialog-cancel-icon"/>
                <Label text="%Cancel" styleClass="dialog-cancel-label"/>
            </HBox>
        </graphic>
        <VBox.margin><Insets top="12"/></VBox.margin>
    </Button>

</VBox>
