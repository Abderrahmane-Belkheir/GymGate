<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.GymGate.UI.controller.RegisterMemberController"
      fx:id="dialogRoot"
      styleClass="register-dialog-card"
      prefWidth="360" maxWidth="360" spacing="4">

    <padding><Insets top="28" right="28" bottom="24" left="28"/></padding>

    <!-- Icon badge + close button -->
    <HBox alignment="CENTER_LEFT">
        <StackPane styleClass="icon-tile-blue-soft" prefWidth="44" prefHeight="44"
                   minWidth="44" minHeight="44" maxWidth="44" maxHeight="44">
            <FontIcon iconLiteral="fas-user" styleClass="icon-tile-glyph" iconSize="18"/>
        </StackPane>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="closeButton" styleClass="dialog-close-btn">
            <graphic><FontIcon iconLiteral="fas-times" styleClass="dialog-close-icon"/></graphic>
        </Button>
    </HBox>

    <Label fx:id="dialogTitleLabel" text="%Register_Member" styleClass="dialog-title">
        <VBox.margin><Insets top="16"/></VBox.margin>
    </Label>

    <Label fx:id="dialogSubtitleLabel"
           text="%Create_a_new_gym_member_before_enrolling_facial_recognition"
           styleClass="dialog-subtitle" wrapText="true">
        <VBox.margin><Insets top="6" bottom="20"/></VBox.margin>
    </Label>

    <!-- STEP 1: form -->
    <VBox fx:id="formPage" spacing="0">

        <Label text="%First_Name" styleClass="dialog-field-label"/>
        <HBox styleClass="dialog-field" alignment="CENTER_LEFT" spacing="10">
            <VBox.margin><Insets top="6" bottom="16"/></VBox.margin>
            <FontIcon iconLiteral="fas-user" styleClass="info-chip-icon"/>
            <TextField fx:id="firstNameField"  styleClass="dialog-field-input" HBox.hgrow="ALWAYS"/>
        </HBox>

        <Label text="%Last_Name" styleClass="dialog-field-label"/>
        <HBox styleClass="dialog-field" alignment="CENTER_LEFT" spacing="10">
            <VBox.margin><Insets top="6" bottom="16"/></VBox.margin>
            <FontIcon iconLiteral="fas-user" styleClass="info-chip-icon"/>
            <TextField fx:id="lastNameField"  styleClass="dialog-field-input" HBox.hgrow="ALWAYS"/>
        </HBox>

        <Label text="%Phone_Number_Optional" styleClass="dialog-field-label"/>
        <HBox styleClass="dialog-field" alignment="CENTER_LEFT" spacing="10">
            <VBox.margin><Insets top="6" bottom="16"/></VBox.margin>
            <FontIcon iconLiteral="fas-phone-alt" styleClass="info-chip-icon"/>
            <TextField fx:id="phoneField"  styleClass="dialog-field-input" HBox.hgrow="ALWAYS"/>
        </HBox>

        <Label text="%Gender" styleClass="dialog-field-label"/>
        <HBox styleClass="dialog-field" alignment="CENTER" spacing="10">
            <VBox.margin><Insets top="6" bottom="22"/></VBox.margin>
            <fx:define>
                <ToggleGroup fx:id="genderToggleGroup"/>
            </fx:define>
            <ToggleButton fx:id="maleToggle" text="%Male" toggleGroup="$genderToggleGroup" selected="true"
                          styleClass="filter-option, filter-option-male" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
            <ToggleButton fx:id="femaleToggle" text="%Female" toggleGroup="$genderToggleGroup"
                          styleClass="filter-option, filter-option-female" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
        </HBox>

        <CheckBox fx:id="skipPhotosCheckBox" text="%Skip_Photos" styleClass="dialog-checkbox">
            <VBox.margin><Insets bottom="16"/></VBox.margin>
        </CheckBox>

        <Button fx:id="proceedButton" styleClass="pill-action-button, pill-action-primary" maxWidth="Infinity">
            <graphic>
                <HBox spacing="10" alignment="CENTER">
                    <FontIcon iconLiteral="fas-camera" styleClass="pill-icon-primary"/>
                    <Label text="%Proceed" styleClass="pill-label-primary"/>
                </HBox>
            </graphic>
        </Button>
    </VBox>

    <!-- STEP 2: camera capture. EnrollmentCameraPanel is inserted at index 0
         by the controller (initialize()); the buttons below stay in FXML. -->
    <VBox fx:id="cameraPageContainer" alignment="CENTER" spacing="16" visible="false" managed="false">
        <VBox.margin><Insets top="4" bottom="4"/></VBox.margin>

        <Button fx:id="takePhotoButton" styleClass="pill-action-button, pill-action-primary" maxWidth="Infinity">
            <graphic>
                <HBox spacing="10" alignment="CENTER">
                    <FontIcon iconLiteral="fas-camera" styleClass="pill-icon-primary"/>
                    <Label text="%Take_Photo" styleClass="pill-label-primary"/>
                </HBox>
            </graphic>
        </Button>

        <HBox fx:id="reviewButtonsRow" spacing="12" alignment="CENTER" visible="false" managed="false">
            <Button fx:id="retakeButton" styleClass="dialog-cancel-button" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                <graphic>
                    <HBox spacing="10" alignment="CENTER">
                        <FontIcon iconLiteral="fas-redo" styleClass="dialog-cancel-icon"/>
                        <Label text="Retake" styleClass="dialog-cancel-label"/>
                    </HBox>
                </graphic>
            </Button>
            <Button fx:id="confirmButton" styleClass="pill-action-button, pill-action-primary" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                <graphic>
                    <HBox spacing="10" alignment="CENTER">
                        <FontIcon iconLiteral="fas-check" styleClass="pill-icon-primary"/>
                        <Label text="%Confirm" styleClass="pill-label-primary"/>
                    </HBox>
                </graphic>
            </Button>
        </HBox>
    </VBox>

    <!-- STEP 3: plan selection, shown after enrollment completes -->
    <VBox fx:id="planPage" spacing="12" visible="false" managed="false">
        <VBox fx:id="planListContainer" spacing="10"/>

        <Button fx:id="finishRegistrationButton" styleClass="pill-action-button, pill-action-primary" maxWidth="Infinity">
            <graphic>
                <HBox spacing="10" alignment="CENTER">
                    <FontIcon iconLiteral="fas-check-circle" styleClass="pill-icon-primary"/>
                    <Label text="%Finish_Registration" styleClass="pill-label-primary"/>
                </HBox>
            </graphic>
        </Button>
    </VBox>

    <!-- STEP 3b: custom plan configuration, shown only when the "Custom" plan
         is selected in planPage. Lets the user set remaining days and a
         start/end date (month + day only — the year is always the current
         year), then pick which real Plan the custom plan is billed against. -->
    <VBox fx:id="customPlanPage" spacing="0" visible="false" managed="false">

        <Label text="%Remaining_Days" styleClass="dialog-field-label"/>
        <HBox styleClass="dialog-field" alignment="CENTER_LEFT" spacing="10">
            <VBox.margin><Insets top="4" bottom="10"/></VBox.margin>
            <FontIcon iconLiteral="fas-hourglass-half" styleClass="info-chip-icon"/>
            <TextField fx:id="remainingDaysField" promptText="30" styleClass="dialog-field-input" HBox.hgrow="ALWAYS"/>
        </HBox>

        <Label text="%Start_Date" styleClass="dialog-field-label"/>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <VBox.margin><Insets top="4" bottom="10"/></VBox.margin>
            <HBox styleClass="dialog-field" alignment="CENTER_LEFT" spacing="10" HBox.hgrow="ALWAYS">
                <FontIcon iconLiteral="fas-calendar-day" styleClass="info-chip-icon"/>
                <ComboBox fx:id="startMonthCombo" styleClass="dialog-date-combo" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
            </HBox>
            <HBox styleClass="dialog-field" alignment="CENTER_LEFT" spacing="10" HBox.hgrow="ALWAYS">
                <ComboBox fx:id="startDayCombo" styleClass="dialog-date-combo" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
            </HBox>
        </HBox>

        <Label text="%End_Date" styleClass="dialog-field-label"/>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <VBox.margin><Insets top="4" bottom="14"/></VBox.margin>
            <HBox styleClass="dialog-field" alignment="CENTER_LEFT" spacing="10" HBox.hgrow="ALWAYS">
                <FontIcon iconLiteral="fas-calendar-check" styleClass="info-chip-icon"/>
                <ComboBox fx:id="endMonthCombo" styleClass="dialog-date-combo" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
            </HBox>
            <HBox styleClass="dialog-field" alignment="CENTER_LEFT" spacing="10" HBox.hgrow="ALWAYS">
                <ComboBox fx:id="endDayCombo" styleClass="dialog-date-combo" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
            </HBox>
        </HBox>

        <Label text="%Bill_Against_Plan" styleClass="dialog-field-label">
            <VBox.margin><Insets bottom="4"/></VBox.margin>
        </Label>
        <VBox fx:id="customPlanListContainer" spacing="8">
            <VBox.margin><Insets bottom="12"/></VBox.margin>
        </VBox>

        <Button fx:id="confirmCustomPlanButton" styleClass="pill-action-button, pill-action-primary" maxWidth="Infinity" disable="true">
            <graphic>
                <HBox spacing="10" alignment="CENTER">
                    <FontIcon iconLiteral="fas-check-circle" styleClass="pill-icon-primary"/>
                    <Label text="%Finish_Registration" styleClass="pill-label-primary"/>
                </HBox>
            </graphic>
        </Button>

        <Button fx:id="backToPlansButton" styleClass="dialog-cancel-button" maxWidth="Infinity">
            <graphic>
                <HBox spacing="10" alignment="CENTER">
                    <FontIcon iconLiteral="fas-arrow-left" styleClass="dialog-cancel-icon"/>
                    <Label text="%Back" styleClass="dialog-cancel-label"/>
                </HBox>
            </graphic>
            <VBox.margin><Insets top="8"/></VBox.margin>
        </Button>
    </VBox>

    <!-- Cancel — available throughout, closes the dialog entirely -->
    <Button fx:id="cancelButton" styleClass="dialog-cancel-button" maxWidth="Infinity">
        <graphic>
            <HBox spacing="10" alignment="CENTER">
                <FontIcon iconLiteral="fas-arrow-left" styleClass="dialog-cancel-icon"/>
                <Label text="%Cancel" styleClass="dialog-cancel-label"/>
            </HBox>
        </graphic>
        <VBox.margin><Insets top="12"/></VBox.margin>
    </Button>

    <Label fx:id="footerNoteLabel" text="Face enrollment will be completed in the next step."
           styleClass="dialog-footer-note" wrapText="true" textAlignment="CENTER">
        <VBox.margin><Insets top="18"/></VBox.margin>
    </Label>

</VBox>