<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (API 31+) backup / transfer rules.
  We exclude everything: no cloud backup, no device-to-device transfer of app
  data. This keeps the stored Supabase JWT and FCM token from surviving an
  uninstall/reinstall or a phone migration. `android:allowBackup="false"` in the
  manifest covers older versions.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
